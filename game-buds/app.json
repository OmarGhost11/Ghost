{
  "expo": {
    "name": "Game Buds",
    "slug": "game-buds",
    "scheme": "gamebuds",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0b14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gamebuds.app"
    },
    "android": {
      "package": "com.gamebuds.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0b14"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#7c5cff"
        }
      ]
    ]
  }
}
